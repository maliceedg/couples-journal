// Prisma schema – this file defines your data model. No SQL needed.
// Run: npm run db:push (to create tables) or npm run db:migrate (to version them)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ——— Users (one per account; can own one journal and/or join one as partner) ———
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?  // legacy / display; prefer firstName + lastName
  firstName     String?
  lastName      String?
  phone         String?  // for future OTP auth
  timezone      String?  // IANA e.g. America/Caracas (VET)
  passwordHash  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt @default(now())
  journal       Journal?       // journal they own (creator)
  journalMember JournalMember[] // journals they joined as partner
  passwordResets PasswordResetToken[]
  cuteTexts     CuteText[]
}

// ——— Password reset (forgot password) ———
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ——— One journal per couple (e.g. "Carla & Edgardo") ———
model Journal {
  id                 String   @id @default(cuid())
  name               String   // e.g. "Carla & Edgardo"
  startDate          DateTime // relationship start date
  accentColor        String?  // hex, e.g. #A56CB9; used for theme
  dateFormat         String?  // 'DMY' (dd/mm/yyyy) or 'MDY' (mm/dd/yyyy)
  songUrl            String?  // YouTube or Spotify link for "Our Song"
  songTitle          String?  // Fetched from oEmbed when saving songUrl (e.g. "Landline")
  songArtist         String?  // Artist name from oEmbed (YouTube author_name; Spotify parsed or from title)
  partnerDisplayName String?  // Partner name until they join; then API returns live partner name
  createdAt          DateTime @default(now())
  userId             String   @unique // owner/creator
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  members   JournalMember[]
  invites   JournalInvite[]
  memories  Memory[]
  milestones Milestone[]
  cuteTexts  CuteText[]
  chatStats  ChatStat[]
}

// ——— Partner link: second user can view/edit same journal ———
model JournalMember {
  id        String   @id @default(cuid())
  journalId String
  userId    String
  createdAt DateTime @default(now())
  journal   Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([journalId, userId])
  @@index([userId])
}

// ——— Invite by code/link: token can be used once to join a journal ———
model JournalInvite {
  id        String    @id @default(cuid())
  token     String    @unique
  journalId String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  journal   Journal   @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([journalId])
}

// ——— Memories (daily or milestone) ———
model Memory {
  id          String   @id @default(cuid())
  title       String
  date        String   // YYYY-MM-DD or any string you like
  imageUrl    String
  type        MemoryType
  description String   @default("")
  createdAt   DateTime @default(now())
  journalId   String
  journal     Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([journalId])
}

enum MemoryType {
  daily
  milestone
}

// ——— Milestones (first hello, first Christmas, etc.) ———
model Milestone {
  id          String   @id @default(cuid())
  date        String
  title       String
  description String
  createdAt   DateTime @default(now())
  journalId   String
  journal     Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([journalId])
}

// ——— Cute / favorite text messages ———
model CuteText {
  id        String   @id @default(cuid())
  text      String
  sender    String
  date      String
  isFavorite Boolean @default(true)
  color     String   @default("white") // "white" | "primary"
  createdAt DateTime @default(now())
  journalId String
  journal   Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([journalId])
  @@index([userId])
}

// ——— Chat stats (total messages, top sender, most active time) ———
model ChatStat {
  id      String   @id @default(cuid())
  icon    String
  value   String
  label   String
  subLabel String?
  createdAt DateTime @default(now())
  journalId String
  journal   Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([journalId])
}
