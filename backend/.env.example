# Copy this to .env and fill in your values.

# Database URL – use your own Postgres, or a free one from:
# - https://neon.tech
# - https://supabase.com (just the DB, not the full BaaS)
# - https://railway.app
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Port for the API (default 3001)
PORT=3001

# Secret for signing JWTs (use a long random string in production)
JWT_SECRET=your-secret-key-change-in-production

# Optional: Spotify app credentials to fetch artist name for "Our Song" (create app at https://developer.spotify.com/dashboard)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Password reset email (works in dev and prod when set). Without RESEND_API_KEY, no email is sent;
# the reset link is only printed in the server console (check the terminal where you run npm run dev).
# Resend free tier: you can only send to the email on your Resend account. To send to any address, verify a domain at resend.com/domains and set RESEND_FROM_EMAIL to an address on that domain.
# APP_URL or FRONTEND_URL = where the reset link points (use http://localhost:5173 for local dev).
# APP_URL=http://localhost:5173
# RESEND_API_KEY=re_xxxx
# RESEND_FROM_EMAIL=LoveStory <noreply@yourdomain.com>  # optional; omit to use onboarding@resend.dev
